<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity"
    tools:layout_editor_absoluteX="-1dp"
    tools:layout_editor_absoluteY="73dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conversor de Moneda"
                android:textColor="@android:color/white"
                android:textSize="26sp"/>

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <EditText
        android:id="@+id/etEuros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvEuros"
        android:layout_alignLeft="@id/tvEuros"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="6dp"
        android:ems="10"
        android:inputType="numberDecimal" />

    <TextView
        android:id="@+id/tvValorConversion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvConversion"
        android:layout_alignLeft="@id/tvConversion"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="15dp"
        android:text="$1=" />

    <RadioGroup
        android:id="@+id/seleccionRadio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvValorConversion"
        android:layout_alignLeft="@id/tvValorConversion"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="5dp">

        <RadioButton
            android:id="@+id/rbDolares"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:checked="false"
            android:text="Convertir a Dolares"
            android:textSize="16sp" />
        />

        <RadioButton
            android:id="@+id/rbEuros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Convertir a Euros"
            android:textSize="16sp" />

    </RadioGroup>

    <TextView
        android:id="@+id/tvConversion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/etEuros"
        android:layout_alignLeft="@id/etEuros"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="35dp"
        android:text="Valor de Conversion" />

    <Button
        android:id="@+id/btConvertir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/seleccionRadio"
        android:layout_alignLeft="@id/seleccionRadio"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="14dp"
        android:text="Convertir" />

    <Button
        android:id="@+id/btCambValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/tvValorConversion"
        android:layout_alignBottom="@+id/tvValorConversion"
        android:layout_marginLeft="0dp"
        android:layout_marginBottom="-15dp"
        android:layout_toRightOf="@+id/tvConversion"
        android:text="Cambiar Valor" />

    <EditText
        android:id="@+id/etCambio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvConversion"
        android:layout_alignLeft="@id/tvValorConversion"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="2dp"
        android:ems="4"
        android:inputType="text"
        android:text="" />

    <EditText
        android:id="@+id/etDolares"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDolares"
        android:layout_alignLeft="@id/tvDolares"
        android:layout_marginLeft="0dp"
        android:layout_marginTop="1dp"
        android:ems="10"
        android:inputType="numberDecimal" />

    <TextView
        android:id="@+id/tvDolares"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="83dp"
        android:text="Dolares" />

    <TextView
        android:id="@+id/tvEuros"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/etDolares"
        android:layout_alignLeft="@id/etDolares"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="19dp"
        android:text="Euros" />

</RelativeLayout>